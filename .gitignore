# 环境与密钥
.env
.venv/
venv/

# 数据（不随仓库分发，只留 .gitkeep 与少量样例）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.db
*.sqlite3

# ✅ 例外：云端看板快照必须入库（由 src/export_snapshot.py 生成）
#    只含 458 行视频明细 + 几个聚合表，约 200KB；8 万条原始弹幕不入库
!data/snapshot/
!data/snapshot/*

# 日志与缓存
logs/*
!logs/.gitkeep
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# 临时探查脚本（自己调试用，不入库）
_check_*.py
_probe*.py

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# Excel/大文件
*.xlsx
!docs/投递清单.xlsx
